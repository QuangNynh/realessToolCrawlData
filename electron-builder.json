{
  "appId": "com.quangny.youtubescheduler",
  "productName": "CrawlData",
  "afterPack": "scripts/after-pack.cjs",
  "publish": {
    "provider": "github",
    "owner": "QuangNynh",
    "repo": "realessToolCrawlData"
  },
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-backend/**/*",
    "dist-electron/**/*",
    "build/icon.png",
    "node_modules/**/*",
    "!node_modules/@ffmpeg-installer/win32-*/**",
    "package.json"
  ],
  "asarUnpack": [
    "node_modules/youtube-dl-exec/bin/**",
    "node_modules/@ffmpeg-installer/**/ffmpeg*"
  ],
  "mac": {
    "target": [{ "target": "dmg", "arch": ["arm64"] }, { "target": "zip", "arch": ["arm64"] }],
    "icon": "build/icon.icns",
    "category": "public.app-category.utilities",
    "extraResources": [{ "from": "build/yt-dlp/mac", "to": "bin" }]
  },
  "win": {
    "icon": "build/icon.ico",
    "extraResources": [
      { "from": "build/yt-dlp/win", "to": "bin" },
      { "from": "build/ffmpeg/win", "to": "bin" }
    ],
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "artifactName": "CrawlData-Setup-${version}.${ext}",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "CrawlData",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico"
  }
}
